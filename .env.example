# Python 3.11+; the web application uses the standard library.
# These launch variables must be set in the shell; .env files are not auto-loaded.
NAJDILAB_PORT=8770
NAJDILAB_NO_DEMO=1
# NAJDILAB_PYTHON=C:\path\to\python.exe
# Required for /api/v1/turn and /api/v1/hermes-hook. Generate a random secret
# locally; never commit a real value. Empty disables ingestion by default.
NAJDILAB_INGEST_TOKEN=
# Migration only: explicit temporary opt-in to unauthenticated native ingestion.
# Browser Origin/Host/CSRF protections remain enabled. A warning is printed.
NAJDILAB_ALLOW_LEGACY_INGEST=0
# Other native API writes require X-NajdiLab-CSRF from GET /api/v1/session.
